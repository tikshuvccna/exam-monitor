{
  "name": "exam-client",
  "version": "1.1.0",
  "description": "Exam Monitor companion agent (kiosk + OS-level lock/input-block + remote launch + remote control)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.exammonitor.client",
    "productName": "Exam Client",
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false },
    "protocols": [
      { "name": "Exam Client", "schemes": ["examclient"] }
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
